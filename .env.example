# Copy this file to .env and fill in what you need.
# The app runs with zero config — everything below is optional.

# --- Data source ---------------------------------------------------------
# Which USGS real-time GeoJSON summary feed to ingest.
# Format is {magnitude}_{period} where magnitude is one of:
#   significant | 4.5 | 2.5 | 1.0 | all
# and period is one of: hour | day | week | month
# Full catalog: https://earthquake.usgs.gov/earthquakes/feed/v1.0/geojson.php
USGS_FEED=2.5_day

# How often (seconds) the background job re-fetches the feed.
REFRESH_INTERVAL_SECONDS=300

# --- AI situation summary (optional) --------------------------------------
# If unset, /api/summary falls back to a deterministic, templated summary —
# the app is fully functional without this key.
ANTHROPIC_API_KEY=

# Model used for the situation summary. See docs.claude.com for current models.
CLAUDE_MODEL=claude-sonnet-5

# --- Storage ---------------------------------------------------------------
# SQLite file used for the hackathon build. The schema is deliberately
# close to a PostGIS table shape so it can be swapped for Postgres+PostGIS
# in Version 1 without changing the application layer (see risk.py / models.py).
DATABASE_URL=sqlite:///./globaltwin.db
